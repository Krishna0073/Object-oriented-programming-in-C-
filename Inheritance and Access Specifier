#include <iostream>
using namespace std;

class Base {
public:
    int x = 10;
};

class A : public Base {
public:
    void show1() {
         cout << "A: " << x+20 << endl; 
        }
};

class B : protected Base {
public:
    void show2() {
         cout << "B: " << x*20 << endl; 
        }
};

class C : private Base {
public:
    void show3() { 
        cout << "C: " << x+30 << endl; 
    }
};
int main(){
    A a;
    B b;
    C c;
    a.show1();
    b.show2();
    c.show3();
}

